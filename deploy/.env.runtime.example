# Copy to .env.runtime on the server and set permissions to 600.
# Never commit or paste the real key into documentation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_PROXY_URL=
AI_MIN_INTERVAL_MS=1500

# Leave empty until a mail provider callback is configured. Generate a dedicated
# random value; never reuse the OpenAI key, SMTP password, or Web password.
FEEDBACK_WEBHOOK_SECRET=

# Read-only mailbox adapter. Use your own provider settings.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FEEDBACK_STATE_PATH=/srv/app/data/imap-feedback-state.json

# Unified mailbox credentials stay outside runtime-data backups and Git.
MAILBOX_ACCOUNTS_PATH=/srv/app/data/mailbox-accounts.json
MAILBOX_STORE_PATH=/srv/app/data/mailboxes.json
MAILBOX_REPLY_STORE_PATH=/srv/app/data/mailbox-replies.json
MAILBOX_REPLY_ENABLED=false
MAILBOX_REPLY_DAILY_LIMIT=50
MAILBOX_INITIAL_SYNC_LIMIT=50
MAILBOX_RETAIN_LIMIT=200

# Real email delivery remains locked for the public-IP deployment.
EMAIL_SENDING_ENABLED=false
EMAIL_ALLOW_UNVERIFIED=false
SEND_BATCH_LIMIT=200
SEND_DAILY_LIMIT=200
DELIVERY_CIRCUIT_COOLDOWN_MINUTES=60
SEND_ACCOUNT_DAILY_LIMIT=20
OPS_ALERT_EMAIL=ops@example.com
SEND_DELAY_MS=2000

# Configure your own SMTP provider, but keep real delivery disabled until
# deliverability, unsubscribe, authorization, and approval gates pass.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sender identity used by the drafting worker. Never invent missing fields.
PIPELINE_SENDER_NAME=
PIPELINE_SENDER_TITLE=
PIPELINE_SENDER_EMAIL=
PIPELINE_SENDER_PHONE=
PIPELINE_SENDER_WEBSITE=

# Non-secret sender metadata is stored in runtime-data on the server.
SENDER_PROFILE_PATH=/srv/app/data/sender-profile.json
SENDER_ACCOUNTS_PATH=/srv/app/data/sender-accounts.json
