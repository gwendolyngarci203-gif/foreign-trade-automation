# OpenAI-compatible Responses API via kuaipao.pro
OPENAI_API_KEY=replace-with-a-rotated-key
OPENAI_BASE_URL=https://kuaipao.pro/v1
OPENAI_MODEL=gpt-5.6-sol
# Optional explicit local egress proxy; leave empty for direct/test environments.
OPENAI_PROXY_URL=
AI_MIN_INTERVAL_MS=1500

# Optional provider feedback webhook. Use a new random secret that is not reused
# for OpenAI, SMTP, Basic Auth, or any other service.
FEEDBACK_WEBHOOK_SECRET=replace-with-a-dedicated-random-secret

# Unified ten-account mailbox. The credential file is mode 600 and outside Git.
MAILBOX_ACCOUNTS_PATH=
MAILBOX_STORE_PATH=
MAILBOX_REPLY_STORE_PATH=
MAILBOX_REPLY_ENABLED=false
MAILBOX_REPLY_DAILY_LIMIT=50
MAILBOX_INITIAL_SYNC_LIMIT=50
MAILBOX_RETAIN_LIMIT=200

# SMTP delivery remains disabled until every required value is configured.
EMAIL_SENDING_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=sender@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=sender@example.com
EMAIL_REPLY_TO=reply@example.com

# Optional hosted-link compliance metadata. Reply-only mode uses the company mailbox instead.
EMAIL_UNSUBSCRIBE_URL=
EMAIL_UNSUBSCRIBE_REPLY_MAILBOX=unsubscribe@example.com
EMAIL_PHYSICAL_ADDRESS=Company name, street, city, country

# Conservative defaults for each manually confirmed batch.
SEND_BATCH_LIMIT=500
SEND_DAILY_LIMIT=500
DELIVERY_CIRCUIT_COOLDOWN_MINUTES=60
SEND_ACCOUNT_DAILY_LIMIT=50
OPS_ALERT_EMAIL=18395655269@163.com
SEND_DELAY_MS=2000

# Keep false for production. Current imported contacts are unverified.
EMAIL_ALLOW_UNVERIFIED=false

# Optional sender signature fields used by the pipeline drafting stage.
PIPELINE_SENDER_COMPANY=DaKings Printing Company
PIPELINE_SENDER_NAME=
PIPELINE_SENDER_TITLE=
PIPELINE_SENDER_EMAIL=
PIPELINE_SENDER_PHONE=
PIPELINE_SENDER_WEBSITE=

# Versioned source-of-truth template. Defaults to app/data/email-template-library.json.
EMAIL_TEMPLATE_LIBRARY_PATH=

# Optional local JSON stores. Defaults are under app/data when omitted.
VALIDATION_PATH=
SUPPRESSION_PATH=
OPERATIONS_PATH=
SENDER_PROFILE_PATH=
SENDER_ACCOUNTS_PATH=
UNSUBSCRIBE_HMAC_SECRET_FILE=D:\zcy\外贸自动化拓客系统\退订HMAC密钥.txt
